{
  "name": "vivarium-world",
  "description": "Git-hosted cultural commons for Vivarium skills, anti-patterns, traces, runs, curricula, trust gates, and validation workflows.",
  "license": "MIT",
  "homepage": "https://github.com/idanmann10/vivarium-world",
  "bugs": {
    "url": "https://github.com/idanmann10/vivarium-world/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idanmann10/vivarium-world.git"
  },
  "private": true,
  "packageManager": "bun@1.3.11",
  "type": "module",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "lint": "bun run scripts/validate-world.ts",
    "launch:security-audit": "bun run scripts/launch-security-audit.ts",
    "public-release:scan": "bun run scripts/public-release-scan.ts",
    "seed": "bun run scripts/seed-content.ts",
    "test": "bun test scripts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/bun": "^1.3.3",
    "typescript": "^6.0.3"
  }
}
